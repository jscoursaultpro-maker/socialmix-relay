# relay-server — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer .env (il est dans .gitignore).

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=

# ─── JWT (session relay interne) ──────────────────────────────────────────────
JWT_SECRET=
REFRESH_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Spotify Web API (PKCE — clientId public, clientSecret serveur) ───────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Apple Music ──────────────────────────────────────────────────────────────
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_PRIVATE_KEY_PATH=

# ─── Cloudinary (photos soirée) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=socialmix/photos

# ─── SendGrid (emails transactionnels) ────────────────────────────────────────
SENDGRID_API_KEY=

# ─── Branding (emails, invitations) ───────────────────────────────────────────
BRAND_NAME=AhOuai
BRAND_DOMAIN=ahouai.com
BRAND_EMAIL=noreply@ahouai.com

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ─── Render (deploy API) ──────────────────────────────────────────────────────
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Flags de développement ───────────────────────────────────────────────────

# SKIP_EDITORIAL_SEED=true
# Sauter le seed éditorial au boot du serveur.
# Utile en dev local pour accélérer le redémarrage (npm start) quand la BDD
# est déjà peuplée. En prod (Render), laisser vide ou false.
# Valeur : 'true' pour sauter, toute autre valeur ou absent pour exécuter.
SKIP_EDITORIAL_SEED=

# ★ Lot 0 (01/10/2026) — MusicKit host web : contenu PEM de la clé .p8 (Render), prime sur _PATH
APPLE_MUSIC_PRIVATE_KEY=
